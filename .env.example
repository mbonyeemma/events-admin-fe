# API the panel calls. Unset = production (https://events-app-be-production.up.railway.app).
# Empty = same origin: the panel served by the API at /panel, or the dev proxy to a local API.
# VITE_API_URL=http://localhost:4000

# Path the panel lives under: "/" standalone (default), "/panel/" when served by the API (npm run build:api).
# VITE_BASE=/
